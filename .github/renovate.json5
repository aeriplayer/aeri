// Rationale for each setting: docs/TOOLING.md.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    ":configMigration",
    "abandonments:recommended",
  ],
  dependencyDashboard: true,
  schedule: ["before 6am on monday"],

  minimumReleaseAge: "7 days",
  minimumReleaseAgeBehaviour: "timestamp-required",
  internalChecksFilter: "strict",
  prCreation: "immediate",
  prHourlyLimit: 0,
  prConcurrentLimit: 0,

  rangeStrategy: "auto",
  cargo: { rangeStrategy: "update-lockfile" },
  "pre-commit": { enabled: true },
  lockFileMaintenance: { enabled: false },

  semanticCommits: "enabled",
  semanticCommitScope: "deps",
  semanticCommitType: "build",

  packageRules: [
    {
      description: "Pin references already in use at once; waiting leaves them mutable",
      matchUpdateTypes: ["pinDigest"],
      minimumReleaseAge: null,
    },
    {
      description: "Runner images move only by deliberate choice",
      matchManagers: ["github-actions"],
      matchDatasources: ["github-runners"],
      enabled: false,
    },
    {
      description: "CI actions in one pull request",
      matchManagers: ["github-actions"],
      groupName: "github actions",
      semanticCommitType: "ci",
    },
    {
      description: "Compatible crate updates in one pull request; majors one by one",
      matchManagers: ["cargo"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "compatible crates",
    },
    {
      description: "The toolchain and the declared rust-version move together",
      matchDepNames: ["rust"],
      groupName: "rust toolchain",
    },
    {
      description: "Hook revisions in .pre-commit-config.yaml",
      matchManagers: ["pre-commit"],
      groupName: "prek hooks",
      semanticCommitType: "ci",
    },
    {
      description: "typos also tags its dictionaries; follow releases only",
      matchManagers: ["pre-commit"],
      matchPackageNames: ["crate-ci/typos"],
      allowedVersions: "/^v\\d+\\.\\d+\\.\\d+$/",
    },
    {
      description: "cargo-dist is pinned in cargo-tools.toml and in dist-workspace.toml",
      matchDepNames: ["cargo-dist"],
      groupName: "cargo-dist",
      semanticCommitType: "ci",
    },
  ],

  customManagers: [
    {
      description: "Cargo tools in .config/cargo-tools.toml, one `crate = \"version\"` per line",
      customType: "regex",
      managerFilePatterns: ["/^\\.config/cargo-tools\\.toml$/"],
      matchStrings: ['(?m)^(?<depName>[a-z0-9_-]+)\\s*=\\s*"(?<currentValue>[^"]+)"$'],
      datasourceTemplate: "crate",
    },
    {
      description: "The rust-version every crate inherits",
      customType: "regex",
      managerFilePatterns: ["/^Cargo\\.toml$/"],
      matchStrings: ['rust-version\\s*=\\s*"(?<currentValue>\\d+\\.\\d+\\.\\d+)"'],
      depNameTemplate: "rust",
      datasourceTemplate: "rust-version",
    },
    {
      description: "cargo-dist version dist expects in CI",
      customType: "regex",
      managerFilePatterns: ["/^dist-workspace\\.toml$/"],
      matchStrings: ['cargo-dist-version = "(?<currentValue>[^"]+)"'],
      depNameTemplate: "cargo-dist",
      datasourceTemplate: "crate",
    },
  ],

  vulnerabilityAlerts: {
    enabled: true,
    labels: ["security"],
    minimumReleaseAge: null,
  },
}
